# Unit OS additions to the Buildroot QEMU x86_64 kernel configuration
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Test harness and trace capture (UNIT-OS-WP-0002): synthetic input, event tracing,
# kernel log timestamps, and the 9p share that returns results to the host
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_PRINTK_TIME=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
# Desktop Foundation - Increment 1 (UNIT-OS-WP-0009): virtual terminal for the compositor session
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
