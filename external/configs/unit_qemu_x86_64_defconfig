# Unit OS image for emulation (QEMU, x86-64). Development configuration image follows.
# Init and service management: systemd with dbus-broker (Software Architecture r1.16 §7),
# moved from BusyBox init under work package UNIT-OS-WP-0009 (Desktop Foundation - Increment 1).
BR2_x86_64=y
BR2_x86_x86_64_v3=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y
BR2_CCACHE=y
BR2_CCACHE_DIR="$(BR2_EXTERNAL_UNIT_PATH)/../.ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=20G"
BR2_DL_DIR="$(BR2_EXTERNAL_UNIT_PATH)/../dl"
BR2_TARGET_GENERIC_HOSTNAME="unit"
BR2_TARGET_GENERIC_ISSUE="Unit OS"
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_DBUS_BROKER=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_UNIT_PATH)/board/unit/common/rootfs-overlay $(BR2_EXTERNAL_UNIT_PATH)/board/unit/qemu-x86_64/rootfs-overlay"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.63"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_UNIT_PATH)/board/unit/qemu-x86_64/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_UNIT_PATH)/board/unit/qemu-x86_64/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_VULKAN_TOOLS=y
BR2_PACKAGE_UNIT_RELEASE=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1024M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_UNIT_FIRMWARE=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_UNIT_PATH)/patches"
BR2_PACKAGE_UNIT_HARNESS=y
# Desktop Foundation - Increment 1 (UNIT-OS-WP-0009): Unit compositor and its graphics and input stack.
# llvmpipe gives software rendering on the emulated GPU; on core.unit the Iris driver renders.
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_BUILTIN=y
BR2_PACKAGE_UNIT_COMPOSITOR=y
# Settings, Notification and Session services for the Shell UI (UNIT-OS-WP-0009).
BR2_PACKAGE_UNIT_SERVICES=y
# Shell UI toolkit: Qt 6 QML (Decision UNIT-OS-DEC-0122; Software Architecture r1.16 §5.2), on
# Wayland with OpenGL ES and the AT-SPI accessibility bridge over D-Bus. Buildroot 2026.02 LTS
# gives Qt 6.9.1; the bridge fix is in external/patches/qt6base.
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_DBUS=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="wayland"
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_PNG=y
# Widgets: needed only by the Fcitx5 Qt input module; the Shell UI uses Qt Quick.
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
BR2_PACKAGE_QT6SHADERTOOLS=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6WAYLAND=y
# Layer surfaces for the Shell UI (wlr-layer-shell, Software Architecture §4).
BR2_PACKAGE_LAYER_SHELL_QT=y
# The Shell UI, started by the compositor (UNIT-OS-WP-0009).
BR2_PACKAGE_UNIT_SHELL=y
# Accessibility bus. Its launcher aborts without a GSettings schema source.
BR2_PACKAGE_AT_SPI2_CORE=y
BR2_PACKAGE_GSETTINGS_DESKTOP_SCHEMAS=y
# Fonts (Visual Design Specification §9).
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FONT_INTER=y
BR2_PACKAGE_FONT_NOTO_SANS_CJK_JP=y
# Japanese input through Fcitx5 (Software Architecture §4, input methods), with Anthy as the
# engine in emulation; the engine for release is not decided yet.
BR2_PACKAGE_FCITX5=y
BR2_PACKAGE_FCITX5_QT=y
BR2_PACKAGE_FCITX5_ANTHY=y
