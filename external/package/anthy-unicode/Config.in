config BR2_PACKAGE_ANTHY_UNICODE
	bool "anthy-unicode"
	depends on BR2_USE_WCHAR
	help
	  Japanese kana-kanji conversion engine (UTF-8 version of Anthy), used by fcitx5-anthy
	  for Japanese input in emulation. The engine for release is not decided yet.

	  https://github.com/fujiwarat/anthy-unicode
