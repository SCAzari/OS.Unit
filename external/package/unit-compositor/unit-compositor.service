# Unit compositor, first version (UNIT-OS-WP-0009, emulation).
# Runs on the first virtual terminal in its own logind session, so libseat uses logind as the
# Session and mode manager will (Software Architecture r1.16 §4). If no logind session can be
# opened, libseat falls back to its built-in backend. Not started by the smoke check or harness.
[Unit]
Description=Unit compositor
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionKernelCommandLine=!unit.smoke=1
ConditionKernelCommandLine=!unit.harness

[Service]
ExecStart=/usr/bin/unit-compositor
Restart=on-failure
RestartSec=2
PAMName=unit-session
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unit-compositor
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=unit-compositor
Environment=XDG_RUNTIME_DIR=/run/unit-compositor
Environment=XDG_SESSION_TYPE=wayland

[Install]
WantedBy=multi-user.target
