#!/bin/sh
# unit-trace: bounded kernel trace capture (Performance procedure PA08).
#
#   unit-trace start [EVENT...]   disable every trace event, clear and size the ring buffer,
#                                 enable only the requested allow-listed events, confirm that
#                                 exactly those are enabled, then start
#   unit-trace stop OUT_FILE      stop; label, verify and bound the trace in memory; write it to
#                                 OUT_FILE only if verification passed; write OUT_FILE.meta (JSON);
#                                 disable every event. Exits non-zero if the trace was rejected.
#   unit-trace export - OUT_FILE  run the stop-time export path (labels, verification, budget,
#                                 write only if passed) on records from standard input, with the
#                                 events in UNIT_TRACE_EVENTS; for regression checks of the filter
#   unit-trace verify FILE|-      check an exported trace (or records on stdin, with the events in
#                                 UNIT_TRACE_EVENTS) without changing it: every record an enabled,
#                                 allow-listed event; payload wholly permitted fields (each once)
#                                 and permitted literals; task and device names only labels.
#                                 Prints JSON (counts and event and field names, never values) and
#                                 exits non-zero on any finding
#
# Workspace: OUT_FILE must resolve inside UNIT_WORKSPACE (default /var/lib/unit-test/results),
# must not be a symbolic link, and its directory must already exist. The tool's state file is
# kept in the workspace too, so nothing outside the workspace is written.
#
# Export (trace-filter.awk): the live trace buffer is read once. Task names in record headers and
# in the comm fields, and interrupt device names, are replaced by fixed labels (idle, kworker,
# ksoftirqd, migration, cpuhp, rcu, the harness tools by name, task; irq). Each record is then
# verified and the result held in memory up to the byte budget, cut at a record boundary. The file
# is written only if every record passed; a rejected trace leaves only OUT_FILE.meta, which holds
# counts and names of event types and fields, never trace content.
#
# Bounds: the kernel ring buffer is UNIT_TRACE_BUFFER_KB per CPU (default 1024); the file
# written is at most UNIT_TRACE_BUDGET bytes (default 4 MiB). Before writing, free space on the
# output filesystem must exceed the budget plus UNIT_TRACE_RESERVE_KB (default 65536); otherwise
# nothing is written and the meta file records "skipped: storage budget".
#
# Privacy: only allow-listed events are accepted. They carry scheduling, interrupt,
# display-timing and power information. After labelling, an exported trace holds process and
# interrupt numbers, CPU numbers, states, counters and fixed labels: no task or device names,
# file content, text, key codes or system-call arguments.
set -eu
T=${TRACEFS:-/sys/kernel/tracing}
BUF=${UNIT_TRACE_BUFFER_KB:-1024}
BUDGET=${UNIT_TRACE_BUDGET:-4194304}
RESERVE=${UNIT_TRACE_RESERVE_KB:-65536}
WS=${UNIT_WORKSPACE:-/var/lib/unit-test/results}
ALLOW="sched:sched_switch sched:sched_wakeup irq:irq_handler_entry irq:irq_handler_exit \
drm:drm_vblank_event drm:drm_vblank_event_queued drm:drm_vblank_event_delivered \
power:cpu_idle power:cpu_frequency"
DEFAULT="sched:sched_switch irq:irq_handler_entry irq:irq_handler_exit drm:drm_vblank_event"
# Permitted fields per event, as printed in the trace text.
FIELDS="sched_switch=prev_comm,prev_pid,prev_prio,prev_state,next_comm,next_pid,next_prio \
sched_wakeup=comm,pid,prio,target_cpu \
irq_handler_entry=irq,name irq_handler_exit=irq,ret \
drm_vblank_event=crtc,seq,time,high-prec drm_vblank_event_queued=file,crtc,seq \
drm_vblank_event_delivered=file,crtc,seq \
cpu_idle=state,cpu_id cpu_frequency=state,cpu_id"
# Permitted literal tokens per event (the separator in sched_switch).
LITERALS="sched_switch:==>"
FILTER=${UNIT_TRACE_FILTER:-/usr/lib/unit-harness/trace-filter.awk}

die() { echo "unit-trace: $*" >&2; exit 1; }
allowed() { for a in $ALLOW; do [ "$a" = "$1" ] && return 0; done; return 1; }
evdir() { echo "$T/events/${1%%:*}/${1#*:}"; }

# inside PATH: true when PATH's directory resolves inside the workspace and PATH is not a link.
inside() {
	w=$(realpath "$WS" 2>/dev/null) || return 1
	d=$(realpath "$(dirname "$1")" 2>/dev/null) || return 1
	[ -L "$1" ] && return 1
	case "$d/" in "$w"/*) return 0 ;; esac
	return 1
}
STATE="$WS/.unit-trace.state"

cmd=${1:-}; [ $# -gt 0 ] && shift

if [ "$cmd" = export ]; then
	[ "${1:-}" = - ] || die "usage: unit-trace export - OUT_FILE"
	out=${2:?usage: unit-trace export - OUT_FILE}; en=${UNIT_TRACE_EVENTS:-}
	[ -n "$en" ] || die "UNIT_TRACE_EVENTS not set"
	inside "$out" || die "output $out is outside the workspace $WS or is a link; nothing written"
	rm -f "$out"
	set +e
	summary=$(awk -v mode=export -v enabled="$en" -v fields="$FIELDS" -v literals="$LITERALS" \
		-v budget="$BUDGET" -v out="$out" -f "$FILTER")
	rc=$?
	set -e
	[ $rc -ne 0 ] && rm -f "$out"
	printf '{"source":"standard input (regression check)","events":["%s"],"budget_bytes":%s,"export":%s}\n' "$(echo $en | sed 's/ /","/g')" "$BUDGET" "$summary" > "$out.meta"
	cat "$out.meta"
	exit $rc
fi

if [ "$cmd" = verify ]; then
	f=${1:?usage: unit-trace verify FILE|-}
	if [ "$f" = - ]; then en=${UNIT_TRACE_EVENTS:-}; f=/dev/stdin
	else en=$(sed -n 's/.*"events":\[\([^]]*\)\].*/\1/p' "$f.meta" 2>/dev/null | tr -d '"' | tr ',' ' '); fi
	[ -n "$en" ] || die "no enabled-event list for $f"
	set +e
	awk -v mode=check -v enabled="$en" -v fields="$FIELDS" -v literals="$LITERALS" -f "$FILTER" "$f"
	exit $?
fi

if [ ! -e "$T/tracing_on" ] && [ "$T" = /sys/kernel/tracing ]; then mount -t tracefs nodev "$T" 2>/dev/null || true; fi
[ -e "$T/tracing_on" ] || die "tracefs not found at $T"
[ -d "$WS" ] || die "workspace $WS does not exist"
case "$cmd" in
start)
	[ $# -eq 0 ] && set -- $DEFAULT
	for e in "$@"; do allowed "$e" || die "event $e is not on the allow list"; done
	echo 0 > "$T/tracing_on"
	# Disable everything first, so that events left on by anything else are not captured.
	echo 0 > "$T/events/enable"
	: > "$T/set_event"
	[ -w "$T/current_tracer" ] && echo nop > "$T/current_tracer"
	: > "$T/trace"
	echo "$BUF" > "$T/buffer_size_kb"
	echo mono > "$T/trace_clock"
	enabled=""
	for e in "$@"; do
		d=$(evdir "$e")
		if [ -w "$d/enable" ]; then echo 1 > "$d/enable"; enabled="$enabled $e"
		else echo "unit-trace: event $e not available in this kernel" >&2; fi
	done
	# Confirm that exactly the requested events are enabled before tracing starts.
	want=$(echo $enabled | tr ' ' '\n' | sort | tr '\n' ' ')
	have=$(sort "$T/set_event" | tr '\n' ' ')
	[ "$want" = "$have" ] || { echo 0 > "$T/events/enable"; die "enabled events differ from the request (enabled: $have)"; }
	echo "$enabled" > "$STATE"
	echo 1 > "$T/tracing_on"
	echo "unit-trace: started:$enabled"
	;;
stop)
	out=${1:?usage: unit-trace stop OUT_FILE}
	echo 0 > "$T/tracing_on"
	enabled=$(cat "$STATE" 2>/dev/null || true)
	# Disable every event (not only those this tool enabled) and clear the buffer.
	disable() { echo 0 > "$T/events/enable"; : > "$T/trace"; rm -f "$STATE"; }
	inside "$out" || { disable; die "output $out is outside the workspace $WS or is a link; nothing written"; }
	[ -e "$out" ] && rm -f "$out"
	dir=$(dirname "$out")
	avail=$(df -k "$dir" | awk 'NR == 2 { print $4 }')
	need=$(( BUDGET / 1024 + RESERVE ))
	overrun=0
	for s in "$T"/per_cpu/cpu*/stats; do
		[ -r "$s" ] || continue
		o=$(awk '/^overrun:/ { print $2 }' "$s"); overrun=$(( overrun + ${o:-0} ))
	done
	rc=0
	if [ "${avail:-0}" -lt "$need" ]; then
		summary='{"verification":"not run","written_bytes":0,"truncated":false}'
		note="skipped: storage budget (free ${avail} KiB, need ${need} KiB)"
	else
		set +e
		summary=$(awk -v mode=export -v enabled="$enabled" -v fields="$FIELDS" -v literals="$LITERALS" \
			-v budget="$BUDGET" -v out="$out" -f "$FILTER" "$T/trace")
		rc=$?
		set -e
		if [ $rc -ne 0 ]; then rm -f "$out"; note="rejected: verification failed; nothing written"
		elif echo "$summary" | grep -q '"truncated":true'; then note="stopped at the storage budget"
		else note="complete"; fi
	fi
	disable
	ev=$(echo $enabled | sed 's/ /","/g')
	printf '{"events":["%s"],"buffer_kb_per_cpu":%s,"budget_bytes":%s,"ring_overrun_events":%s,"labels":"task and device names replaced by fixed labels before writing","note":"%s","export":%s}\n' \
		"$ev" "$BUF" "$BUDGET" "$overrun" "$note" "$summary" > "$out.meta"
	cat "$out.meta"
	exit $rc
	;;
*)
	die "usage: unit-trace start [EVENT...] | stop OUT_FILE | export - OUT_FILE | verify FILE|-"
	;;
esac
