# Unit Notification service: notifications, the notification centre and Do not disturb (UNIT-OS-WP-0009).
# Started by D-Bus activation when first called.
[Unit]
Description=Unit Notification service

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/bin/unit-notifications
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
