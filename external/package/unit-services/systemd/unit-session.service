# Unit Session service: lists and launches applications, save before closing (UNIT-OS-WP-0009).
# Started by D-Bus activation when first called.
[Unit]
Description=Unit Session service

[Service]
Type=dbus
BusName=os.unit.Session1
ExecStart=/usr/bin/unit-session
Restart=on-failure
RestartSec=1
# Applications it started keep running if the service restarts.
KillMode=process
NoNewPrivileges=yes
