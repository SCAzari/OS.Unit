# Unit Settings service: typed settings with limits, kept per profile (UNIT-OS-WP-0009).
# Started by D-Bus activation when first called.
[Unit]
Description=Unit Settings service

[Service]
Type=dbus
BusName=os.unit.Settings1
ExecStart=/usr/bin/unit-settings
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
