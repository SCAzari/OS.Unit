config BR2_PACKAGE_UNIT_SHELL
	bool "unit-shell"
	depends on BR2_PACKAGE_UNIT_COMPOSITOR
	depends on BR2_PACKAGE_UNIT_SERVICES
	depends on BR2_PACKAGE_QT6BASE_DBUS && BR2_PACKAGE_QT6BASE_GUI
	depends on BR2_PACKAGE_QT6DECLARATIVE_QUICK
	depends on BR2_PACKAGE_QT6WAYLAND
	depends on BR2_PACKAGE_QT6SVG
	select BR2_PACKAGE_LAYER_SHELL_QT
	help
	  Unit Shell UI: the status bar, navigation bar and home screen
	  of Unit OS, in Qt 6 QML (UNIT-OS-DEC-0122), drawn as layer
	  surfaces of the Unit compositor, which starts it. A view over
	  the Unit services (Software Architecture r2.0 §4). Work
	  package UNIT-OS-WP-0009.
